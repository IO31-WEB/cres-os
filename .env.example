# Environment variables reference (no real values here — copy to `.env.local` and fill in)
#
# Every one of these is read only in server-side code (server actions, API
# routes, the Clerk webhook, or the cron endpoint) — none are exposed to the
# browser. As a rule for this project: an env var should only ever get a
# NEXT_PUBLIC_ prefix if its value is meant to be public (e.g. Clerk's
# publishable key, which is designed to be embedded in client code). Never
# add that prefix to an API key, a database URL, or a shared secret.
#
# This file is safe to commit — it contains no secrets, only variable
# names and comments. `.env`, `.env.local`, and `.env*.local` are all
# gitignored (see .gitignore) and must never be committed.

# --- Database (Neon Postgres) ---
DATABASE_URL=

# --- Auth (Clerk) ---
# Publishable key is intentionally public (NEXT_PUBLIC_) — Clerk's own
# design. The secret key and webhook signing secret are not.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# --- AI (Anthropic) ---
ANTHROPIC_API_KEY=

# --- Document storage (Cloudflare R2, S3-compatible) ---
# The bucket itself must be private (no public access, no r2.dev URL
# enabled) — see docs/MODULE_SECURITY_SETUP.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DOCUMENTS_BUCKET=

# --- Shared secrets for server-to-server / scheduled endpoints ---
# Sent as `Authorization: Bearer <CRON_SECRET>` by Vercel Cron.
CRON_SECRET=
# Sent as the `x-lead-intake-secret` header by every inbound-lead
# integration (website form, email rule, Facebook/WhatsApp/BizBuySell).
LEAD_INTAKE_SECRET=

# --- Third-party data sources (site-quality scorecard) ---
GOOGLE_API_KEY=
CENSUS_API_KEY=
FBI_CRIME_API_KEY=
